#!/bin/bash

THEME=$(jq -r '.theme' "$HOME/.config/theme/config.json")
ROFI="~/.config/rofi/wallpaper/config.rasi"

DIR_WALLPAPER="$HOME/.Wallpaper"
DIR_PREVIEWS="/tmp/rofi_wallpaper_previews"

[ ! -d "$DIR_PREVIEWS" ] && mkdir -p "$DIR_PREVIEWS"

get_optimal_jobs() {
    cpus=$(nproc 2>/dev/null || echo 4)
    echo $(( cpus > 2 ? cpus * 3 / 4 : 2 ))
}

process_image() {
    local file="$1"
    local name=$(basename "$file")
    local cache_file="$DIR_PREVIEWS/${name}.png"
    local md5_file="$DIR_PREVIEWS/.${name}.md5"
    local lock_file="$DIR_PREVIEWS/.lock_${name}"
    local current_md5
    current_md5=$(xxh64sum "$file" | cut -d " " -f1)
    (
        flock -x 9
        if [ ! -f "$cache_file" ] || [ "$current_md5" != "$(cat "$md5_file" 2>/dev/null)" ]; then
            convert "$file" -resize 272x272^ -gravity center \
                -crop 272x272+0+0 +repage "$cache_file"
            echo "$current_md5" > "$md5_file"
        fi
        rm -f "$lock_file"
    ) 9>"$lock_file"
}

process_video(){
    local file="$1"
    local name=$(basename "$file")
    local cache_file="$DIR_PREVIEWS/${name}.png"
    local md5_file="$DIR_PREVIEWS/.${name}.md5"
    local lock_file="$DIR_PREVIEWS/.lock_${name}"
    local current_md5
    current_md5=$(xxh64sum "$file" | cut -d " " -f1)
    (
        flock -x 9
        if [ -f "$cache_file" ] && [ "$current_md5" = "$(cat "$md5_file" 2>/dev/null)" ]; then
            rm -f "$lock_file"
            exit 0
        fi
        nice -n 19 ionice -c 3 \
        ffmpeg -threads 1 -y -ss 2 -i "$file" -frames:v 1 \
            -vf "scale=272:272:force_original_aspect_ratio=increase,crop=272:272" \
            -q:v 5 "$cache_file" >/dev/null 2>&1
        echo "$current_md5" > "$md5_file"
        rm -f "$lock_file"
    ) 9>"$lock_file"
}

export -f process_image process_video
export DIR_PREVIEWS

find "$DIR_WALLPAPER" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -print0 | \
    xargs -0 -P "$(get_optimal_jobs)" -I {} nice -n 19 ionice -c 3 bash -c 'process_image "$1"' _ {}

find "$DIR_WALLPAPER" -maxdepth 1 -type f \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.webm" \) -print0 | \
    xargs -0 -P 2 -I {} bash -c 'process_video "$1"' _ {}

# Clean files
for cached in "$DIR_PREVIEWS"/*.png; do
    [ -f "$cached" ] || continue
    name=$(basename "$cached" .png)        
    original="${DIR_WALLPAPER}/${name}"
    if [ ! -f "$original" ]; then
        rm -f "$cached" \
            "${DIR_PREVIEWS}/.${name}.md5" \
            "${DIR_PREVIEWS}/.lock_${name}"
    fi
done

MENU_FILE=$(mktemp "$DIR_PREVIEWS/wall_menu_XXXX.txt")

while IFS= read -r -d '' WALL; do
    NAME=$(basename "$WALL")
    THUMB="$DIR_PREVIEWS/${NAME}.png"
    [ -f "$THUMB" ] || continue   
    printf '%s\000icon\037%s\n' "$NAME" "$THUMB" >> "$MENU_FILE"
done < <(find "$DIR_WALLPAPER" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.mp4" -o \
    -iname "*.mkv" -o -iname "*.webm" \) ! -iname "AppliedWallpaper.png" -print0 | LC_ALL=C sort -z)

wall_selection=$(rofi -input "$MENU_FILE" -dmenu -p "󰥱 Wallpapers" -show-icons -icon-size "272" \
    -theme-str '     
        window {
            height:                      760px;
        } 
        element-text {
            font:               "JetBrainsMono NF Bold 10";
            background-color:   transparent; 
            size:               10px;
            text-color:         @selected;
            padding:            10px;
            horizontal-align:   0.5;
            vertical-align:     0.5;
            expand:             true;
        }
        element-text selected { 
            text-color:         @background;
        }
        element selected { 
            background-color:   @selected;
        }' -theme $ROFI
)
rm -f "$MENU_FILE"

if [ -n "$wall_selection" ]; then
    selected="$DIR_WALLPAPER/${wall_selection}"
    ext="${selected##*.}"

    if pgrep -x xwinwrap > /dev/null; then
        pkill xwinwrap
    fi

    sleep 0.5

    if echo "$ext" | grep -iqE 'jpg|jpeg|png|webp'; then
        cp -r "$selected" "$DIR_WALLPAPER/AppliedWallpaper.png"
        cp -r "$selected" "$HOME/.BSPWM/Themes/$THEME/Wallpaper/AppliedWallpaper.png"
        feh --no-fehbg --bg-fill "$DIR_WALLPAPER/AppliedWallpaper.png"

    elif echo "$ext" | grep -iqE 'mp4|mkv|webm'; then
        resolution=$(xrandr | grep '*' | awk '{print $1}')
        xwinwrap -g "${resolution}+0+0" -ni -s -st -sp -b -nf -fdt -argb -- \
            mpv -wid WID --loop --no-audio --no-terminal --panscan=1 "$selected" &

        (
            nice -n 19 ionice -c 3 ffmpeg -y -i "$selected" \
                -vf "select=eq(n\,0)" -vframes 1 \
                "${DIR_WALLPAPER}/AppliedWallpaper.png" 2>/dev/null

            static_name="Static-${wall_selection%.*}.png"
            for dest in \
                "$HOME/.Wallpaper/${static_name}" \
                "$HOME/.BSPWM/Themes/$THEME/Wallpaper/AppliedWallpaper.png" \
                "$HOME/.BSPWM/Themes/$THEME/Wallpaper/${static_name}"
            do
                cp "${DIR_WALLPAPER}/AppliedWallpaper.png" "$dest"
            done
        ) &
    fi

    if [ "$THEME" = "ZeroColor" ]; then
        (
            if pgrep -x polybar > /dev/null; then
                pkill polybar
                pkill -f "$HOME/.config/polybar/launch.sh"
            fi

            if pgrep -x eww > /dev/null; then
                pkill eww
                pkill -f "$HOME/.config/eww/Bar.sh"
            fi
           
            if echo "$ext" | grep -iqE 'jpg|jpeg|png|webp'; then
                ~/.config/bin/scripts/color_picker/pywal.sh --dir "$HOME/.Wallpaper/AppliedWallpaper.png"
            else
                ~/.config/bin/scripts/color_picker/pywal.sh --dir "$DIR_PREVIEWS/$wall_selection.png"
            fi

            rm -rf "$HOME/.config/cava/config" "$HOME/.config/dunst/colors.conf" \
                "$HOME/.BSPWM/Themes/ZeroColor/Wallpaper/AppliedWallpaper.*"
            
            cp -r "$HOME/.BSPWM/Themes/ZeroColor/colors" "$HOME/.config/theme/"

            EWW="$HOME/.BSPWM/Themes/ZeroColor/colors/eww.scss"
            for dest in \
                "$HOME/.config/eww/colors.scss" \
                "$HOME/.config/eww/widgets/calendar/colors.scss" \
                "$HOME/.config/eww/widgets/profilecard/colors.scss"
            do
                rm -f "$dest"
                cp "$EWW" "$dest"
            done

            ~/.config/bin/scripts/color_picker/colors.sh
            pkill -USR1 cava 2>/dev/null
            pkill dunst
            . ~/.cache/wal/colors.sh
            bspc config focused_border_color "${color1}"
            bspc config normal_border_color  "#3e3e3e"
            bspc wm -r
        ) &
    fi
    wait
fi