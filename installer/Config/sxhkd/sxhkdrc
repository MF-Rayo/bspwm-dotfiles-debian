# Raise volume (Fn + Vol Up / Plus)
XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +1%

# Lower volume (Fn + Vol Down / Minus)
XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -1%

# Mute volume (Optional)
XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# Next track (Fn + Next)
XF86AudioNext
    playerctl next

# Previous track (Fn + Previous)
XF86AudioPrev
    playerctl previous

# Play / Pause (Fn + Play/Pause)
XF86AudioPlay
    playerctl play-pause
